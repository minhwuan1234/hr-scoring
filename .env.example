OPEN_AI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Required on Railway: set this to the Postgres service reference.
DATABASE_URL=
# Optional local-only file storage when DATABASE_URL is not set.
# SCORING_DATA_DIR=/data/hr-scoring
MATCH_THRESHOLD=0.70
PORT=3001

# Lark internal app credentials (server-only; LARK_APP_ or LARK_ID / LARK_SECRET are also supported).
LARK_APP_ID=
LARK_APP_SECRET=

# Optional: dedicated CV link signing key; defaults to the Lark app secret.
# CV_LINK_SECRET=
# Optional: HTTPS public app origin for automatically generated CV links.
# PUBLIC_APP_URL=https://honest-presence-production-89d2.up.railway.app

# Reject identity verification uses Lark web login. Register the exact URL
# <PUBLIC_APP_URL>/lark/review/callback in the Lark app's redirect settings.
# PUBLIC_APP_URL must be the actual public HTTPS origin (cookies require HTTPS).
